# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB Atlas connection string (get from Atlas > Connect > Drivers)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentDB?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev example: http://localhost:3000,http://127.0.0.1:5500
# Production example: https://your-app.netlify.app
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# Port for the Express server (Render sets this automatically)
PORT=5000
